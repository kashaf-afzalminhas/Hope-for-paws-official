# Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env file to version control
# 
# To set up: Copy this file and rename it to .env, then fill in your actual values
# Command: Copy-Item env.template .env

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here
# Alternative MongoDB URI (uncomment if needed)
#MONGO_URI=your_alternative_mongodb_connection_string_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Node Environment
#NODE_ENV=production
NODE_ENV=development

# Email Configuration (Gmail)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_PASS=your_gmail_app_password_here
RECIPIENT_EMAIL=your_recipient_email@gmail.com

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Abstract API Key (for IP geolocation)
ABSTRACT_API_KEY=your_abstract_api_key_here

# Frontend URL
FRONTEND_URL=http://localhost:5173
